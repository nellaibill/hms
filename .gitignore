# =========================
# Environment / secrets
# =========================
# .env.development and .env.test hold non-secret local/test defaults and are meant to be
# committed (docs/Configuration.md); .env and any *.local variant are per-developer and
# are never committed.
.env
.env.local
.env.*.local
!.env.example
!.env.development
!.env.test

# =========================
# IDE
# =========================
.idea/
*.swp

# Claude Code: per-session/local permission grants, not shared team config.
.claude/settings.local.json

# HMS Dev Helper: per-developer VM path/secrets, same handling as .env above.
scripts/dev-helper/config.local.json

