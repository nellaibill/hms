# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.
# See docs/Configuration.md for the full secrets-handling policy.

POSTGRES_USER=hms
POSTGRES_PASSWORD=change-me
# 5433, not 5432 — avoids clashing with a locally installed Postgres, if any.
POSTGRES_PORT=5433

TENANT_DB_NAME=hms_qa
PLATFORM_DB_NAME=hms_platform

API_PORT=8080

# Reuses HMS.Api's existing dev-time auto-migrate/seed block inside the container — see
# the comment in docker-compose.yml. Not a real production hardening setting yet.
ASPNETCORE_ENVIRONMENT=Development

# Any long random string (32+ chars). Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=change-me

# Must satisfy the app's password policy (see SuperAdminSeed / PlatformAdminSeed validation).
SUPER_ADMIN_PASSWORD=change-me
PLATFORM_ADMIN_PASSWORD=change-me
