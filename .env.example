# Copy this file to .env (gitignored — never commit real secrets) and fill in real values
# before running `docker compose up -d --build`. See docs/Docker.md.

# --- Postgres (container-internal; also used for the optional host-exposed port) ---
POSTGRES_USER=hms
POSTGRES_PASSWORD=hms

# --- Ports published to the host / browser ---
POSTGRES_PORT=5432
API_PORT=8080
FRONTEND_PORT=8081

# --- Legacy/default tenant database name (ConnectionStrings:Default) ---
TENANT_DB_NAME=hms_qa

# --- Secrets normally supplied via `dotnet user-secrets` in local dev (docs/Configuration.md) ---
# Any long random string is fine for a demo.
JWT_SIGNING_KEY=change-me-to-a-long-random-string
# Must satisfy the hospital seed password policy (see docs/Configuration.md).
SUPER_ADMIN_PASSWORD=Change-Me-123!
PLATFORM_ADMIN_PASSWORD=Change-Me-123!
