# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.
# See docs/Configuration.md for the full secrets-handling policy.

POSTGRES_USER=hms
POSTGRES_PASSWORD=change-me
# 5433, not 5432 — avoids clashing with a locally installed Postgres, if any.
POSTGRES_PORT=5433

TENANT_DB_NAME=hms_qa
PLATFORM_DB_NAME=hms_platform

API_PORT=8080
FRONTEND_PORT=80

# The host/IP browsers will reach this deployment at (no protocol). Baked into the
# frontend's JS bundle at build time as part of VITE_API_BASE_URL — changing it requires
# `docker compose build frontend` again, a running container can't pick up a new value.
PUBLIC_HOST=localhost

# The frontend's exact origin as the browser sends it (protocol + host, port only if not
# 80/443) — must match exactly or CorsConfiguration's fail-closed policy blocks every
# request from the frontend to the API. e.g. http://148.113.9.103 for FRONTEND_PORT=80,
# or http://148.113.9.103:8081 if you changed FRONTEND_PORT.
CORS_ALLOWED_ORIGIN=http://localhost

# Defaults to Production if unset. Migrations run via the dedicated `migrate` service
# (docker-compose.yml) either way — this only controls the running api container (e.g.
# Swagger UI is Development-only). Set to Development here for local Docker debugging.
ASPNETCORE_ENVIRONMENT=Production

# Any long random string (32+ chars). Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=change-me

# Must satisfy the app's password policy (see SuperAdminSeed / PlatformAdminSeed validation).
SUPER_ADMIN_PASSWORD=change-me
PLATFORM_ADMIN_PASSWORD=change-me

# Non-secret — optional, defaults shown are docker-compose.yml's own fallback values.
# PLATFORM_ADMIN_FULL_NAME=Platform Support
# PLATFORM_ADMIN_EMAIL=support@yourhms.com
# SUPER_ADMIN_USERNAME=superadmin
# SUPER_ADMIN_FIRST_NAME=Super
# SUPER_ADMIN_LAST_NAME=Admin
# SUPER_ADMIN_EMAIL=superadmin@hms.local
