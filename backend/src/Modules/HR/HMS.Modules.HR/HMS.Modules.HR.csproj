<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Controllers live in this module (not HMS.Api), so their <summary> comments
         must be generated here for Swashbuckle to include them in Swagger UI. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment on a public member) is not useful here: this module is
         internal-by-default (see docs/DeveloperHandbook.md §4), so its few public members
         are a deliberate narrow seam, not a fully-documented public API. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed for ControllerBase/[ApiController]/IActionResult in Endpoints/, since this
         module is a plain class library, not an ASP.NET Core Web SDK project. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\HMS.Shared.Kernel\HMS.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\..\Shared\HMS.Shared.Infrastructure\HMS.Shared.Infrastructure.csproj" />
    <!-- Only for IUserService (public seam) — used to validate that a StaffId
         actually refers to a real user before writing a ShiftAssignment/StaffAvailability/
         ShiftSwapRequest. The same cross-module pattern HMS.Modules.Products already uses
         against HMS.Modules.Masters. Domain.User/UserRepository etc. stay internal to
         Identity; only IUserService is public. -->
    <ProjectReference Include="..\..\Identity\HMS.Modules.Identity\HMS.Modules.Identity.csproj" />
    <!-- Only for IDepartmentService (public seam) — Department was consolidated out of this
         module into Masters (see docs/DecisionLog.md) so HR and Patients share one
         department list instead of maintaining two independently. Domain.Department stays
         internal to Masters; only IDepartmentService is public. -->
    <ProjectReference Include="..\..\Masters\HMS.Modules.Masters\HMS.Modules.Masters.csproj" />
    <!-- Only for IDocumentOwnerExistenceChecker/IDocumentService (public seams) — this module
         implements the Staff owner-type existence checker (StaffDocumentOwnerExistenceChecker)
         so the generic Documents module can validate uploads against hr.employees, mirroring
         HMS.Modules.Patients' identical one-directional dependency on Documents for its own
         checker. Domain/Application internals of Documents stay internal; only the two public
         interfaces above are referenced. -->
    <ProjectReference Include="..\..\Documents\HMS.Modules.Documents\HMS.Modules.Documents.csproj" />
  </ItemGroup>

</Project>
