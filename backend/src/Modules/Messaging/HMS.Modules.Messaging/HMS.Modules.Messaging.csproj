<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ConversationsController (added in a later phase) will live in this module, not
         HMS.Api, so its <summary> comments must be generated here for Swashbuckle. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment on a public member) is not useful here: this module is
         internal-by-default (see docs/Architecture.md), so its few public members are a
         deliberate narrow seam, not a fully-documented public API. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed for ControllerBase/[ApiController]/IActionResult in Endpoints/ (added in a
         later phase), since this module is a plain class library, not an ASP.NET Core Web
         SDK project. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- FluentValidation.DependencyInjectionExtensions is deliberately NOT referenced: its
         AddValidatorsFromAssembly* scanners only find *public* IValidator<T>
         implementations, and this module's validators (added in a later phase) are internal
         by design — see docs/DeveloperHandbook.md §8/§20. -->
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\HMS.Shared.Kernel\HMS.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\..\Shared\HMS.Shared.Infrastructure\HMS.Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Notifications\HMS.Modules.Notifications\HMS.Modules.Notifications.csproj" />
  </ItemGroup>

</Project>
