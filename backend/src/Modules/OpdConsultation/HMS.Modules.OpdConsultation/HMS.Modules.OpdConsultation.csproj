<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- OpdConsultationsController lives in this module (not HMS.Api), so its <summary>
         comments must be generated here for Swashbuckle to include them in Swagger UI. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment on a public member) is not useful here: this module is
         internal-by-default (see docs/Architecture.md), so its few public members are a
         deliberate narrow seam, not a fully-documented public API. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed for ControllerBase/[ApiController]/IActionResult in Endpoints/, since this
         module is a plain class library, not an ASP.NET Core Web SDK project. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- FluentValidation.DependencyInjectionExtensions is deliberately NOT referenced: its
         AddValidatorsFromAssembly* scanners only find *public* IValidator<T>
         implementations, and this module's validators are internal by design — see
         docs/DeveloperHandbook.md §8/§20. -->
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\HMS.Shared.Kernel\HMS.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\..\Shared\HMS.Shared.Infrastructure\HMS.Shared.Infrastructure.csproj" />
    <!-- ConsultationId/PatientId/VisitId are validated via Patients' public IOpdQueryService/
         IPatientService (Application namespace, same CS0051-driven public seam as every other
         module's IXService) — no DB FK across schemas, per docs/DatabaseArchitecture.md §7. -->
    <ProjectReference Include="..\..\Patients\HMS.Modules.Patients\HMS.Modules.Patients.csproj" />
    <!-- DiagnosisId/ReferralDepartmentId/ReferralConsultantId are validated via Masters' public
         IDiagnosisService/IDepartmentService/IConsultantService, same reasoning. -->
    <ProjectReference Include="..\..\Masters\HMS.Modules.Masters\HMS.Modules.Masters.csproj" />
  </ItemGroup>

</Project>
