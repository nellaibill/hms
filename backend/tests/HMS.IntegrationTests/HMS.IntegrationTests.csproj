<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="coverlet.collector" />
    <!-- Direct pin, not just a transitive dependency: forces resolution of the patched
         System.Security.Cryptography.Xml version pulled in by Testcontainers/Docker.DotNet
         (and by this project's EF Core Design dependency via HMS.Api) — see
         Directory.Packages.props for why. -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <!-- Same reasoning, same precedent as the pin above: Testcontainers.PostgreSql pulls in a
         vulnerable transitive SSH.NET (GHSA-q939-rpr3-3284, high severity) even at its current
         pinned version — see Directory.Packages.props for the patched version this forces. -->
    <PackageReference Include="SSH.NET" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HMS.Api\HMS.Api.csproj" />
  </ItemGroup>

</Project>
