{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": [
    "types",
    "api-client",
    "auth-client",
    "dtos",
    "enums",
    "validation",
    "constants",
    "errors",
    "utils"
  ]
}
