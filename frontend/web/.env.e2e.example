# Copy to .env.e2e (git-ignored) and fill in a dedicated, non-production test account.
# Never commit real credentials.

# Where the HMS web app is running (npm run dev). Defaults to http://localhost:5173.
TEST_BASE_URL=http://localhost:5173

# Optional: run on an installed browser ('chrome' or 'msedge') instead of bundled Chromium.
# TEST_BROWSER_CHANNEL=chrome

# Hospital (tenant) code typed into the login page's "Hospital code" field.
TEST_HOSPITAL_CODE=
# "Sign in as" option label exactly as shown on the login page. Defaults to Super Admin.
TEST_ROLE=Super Admin
TEST_USERNAME=lhsadmin
TEST_PASSWORD=Lakshmi@123
