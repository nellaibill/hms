<Project>

  <!--
    Central Package Management: every NuGet package version is declared
    here once. Individual .csproj files reference packages by name only
    (no Version attribute) via <PackageReference Include="..." />.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="3.10.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />

    <!-- Data access -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <!-- Npgsql's EF Core provider version tracks the EF Core major version; confirm the
         published 10.x version when restoring for real — see backend/README.md. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />

    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />

    <!-- Excel parsing (Patient Import module only) -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />

    <!-- Image decoding (Branding module only) — confirms an uploaded logo's actual content
         decodes as a real raster image and reads its real pixel dimensions, rather than
         trusting the filename extension alone. -->
    <!-- Pinned to a version past GHSA-rxmq-m78w-7wmc (GIF decoder infinite-loop DoS, fixed in
         3.1.11) — relevant here since logo uploads are untrusted user content. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />

    <!-- API documentation -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />

    <!-- Authentication -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
    <!-- RFC 6238 TOTP codes for Platform Admin MFA (HMS.Modules.Platform's TotpService) —
         a well-established, single-purpose library rather than hand-rolling HMAC-based
         one-time-code generation for a security-critical primitive. -->
    <PackageVersion Include="Otp.NET" Version="1.4.0" />
    <!-- Test-only: builds an in-memory IConfiguration for JwtTokenGeneratorTests, without
         pulling in the full Microsoft.AspNetCore.App shared framework just for tests. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.0" />

    <!-- Transitive-only pin: Microsoft.EntityFrameworkCore.Design 10.0.0 (and, via
         Testcontainers, Docker.DotNet) drag in System.Security.Cryptography.Xml 9.0.0,
         which has several published high-severity CVEs (NU1903). Pinned up to the first
         patched 10.x release so the vulnerable transitive version is never resolved. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <!-- Transitive-only pin: Testcontainers.PostgreSql (via Docker.DotNet's SSH-based Docker
         host support) drags in a vulnerable SSH.NET even at Testcontainers' own current
         version (GHSA-q939-rpr3-3284, "ScpClient Recursive Download Allows Arbitrary File
         Write via Server-Controlled SCP Filenames", high severity, NU1903). Found while adding
         CI's dependency-vulnerability gate (ADR-078). Per the advisory's own data
         (vulnerable_version_range "<= 2025.1.0", first_patched_version "2026.0.0" — confirmed
         directly against the GHSA API, not guessed), 2026.0.0 is the first version that
         resolves the NU1903 warning; earlier 2024.x/2025.x releases are still in range. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
