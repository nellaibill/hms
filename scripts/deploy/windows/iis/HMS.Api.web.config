<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS alternative to the NSSM path (install-api-service.ps1, one directory up): copy this file
  to C:\hms\backend\publish\web.config after `dotnet publish` (it overwrites the SDK's
  auto-generated one, which has no environment variables wired up) and fill in every
  __PLACEHOLDER__ below. Same env var names/values install-api-service.ps1 already sets for
  the NSSM path (Section__Key convention, see docs/Configuration.md) - no application code
  changes either way, just a different process supervisor.

  Prerequisites on the server: IIS with the URL Rewrite module, plus the ASP.NET Core Hosting
  Bundle matching this app's target framework (net10.0) - that installs AspNetCoreModuleV2
  into IIS. See docs/Deployment.md's IIS section for the full step-by-step.

  After copying this into place: create an IIS Application Pool with .NET CLR version set to
  "No Managed Code" (ASP.NET Core doesn't run under the classic CLR), Start Mode
  "AlwaysRunning", and point an IIS Application at C:\hms\backend\publish using that pool.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <!-- Routes every request under this IIS Application to the ASP.NET Core Module -
             installed by the Hosting Bundle, not by this file. -->
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!-- hostingModel="InProcess" (the SDK's default) runs the app inside IIS's own w3wp.exe
           worker process instead of spawning a separate Kestrel process behind a proxy - this
           is what replaces NSSM: IIS's own Application Pool supervises the process, restarts
           it on crash, and starts it on boot. No ASPNETCORE_URLS here (unlike the NSSM path) -
           IIS owns the socket via its site bindings, not this process. -->
      <aspNetCore processPath="dotnet"
                  arguments=".\HMS.Api.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="InProcess">
        <environmentVariables>
          <!-- Production gates Swagger off (SwaggerConfiguration.cs's IsDevelopment() check)
               and stops the Development-only auto-migrate-on-startup - run migrations
               explicitly instead (dotnet HMS.Api.dll migrate) before this app pool starts
               serving the new version, per docs/Deployment.md's Database Migration
               Deployment section. -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

          <!-- Same physical database for Default and Platform as the NSSM path uses -
               Branding's pre-login schema is isolated by schema name, not a second database.
               Real hospitals are provisioned through Register Hospital, not this connection
               string. -->
          <environmentVariable name="ConnectionStrings__Default" value="Host=localhost;Port=5432;Database=hms_platform;Username=__PG_USER__;Password=__PG_PASSWORD__" />
          <environmentVariable name="ConnectionStrings__Platform" value="Host=localhost;Port=5432;Database=hms_platform;Username=__PG_USER__;Password=__PG_PASSWORD__" />
          <environmentVariable name="ConnectionStrings__PlatformAdmin" value="Host=localhost;Port=5432;Database=postgres;Username=__PG_USER__;Password=__PG_PASSWORD__" />

          <environmentVariable name="Jwt__SigningKey" value="__JWT_SIGNING_KEY__" />
          <environmentVariable name="SuperAdminSeed__Password" value="__SUPER_ADMIN_PASSWORD__" />
          <environmentVariable name="PlatformAdminSeed__Password" value="__PLATFORM_ADMIN_PASSWORD__" />

          <!-- Must exactly match the origin the browser sends (scheme + host, no trailing
               slash) - CorsConfiguration.cs fails closed on any mismatch, never
               AllowAnyOrigin. -->
          <environmentVariable name="Cors__AllowedOrigins__0" value="https://__PUBLIC_DOMAIN__" />

          <!-- Daily backup job (HMS.Modules.Backups) - pg_dump.exe must actually exist at this
               path and match the Postgres server's major version. -->
          <environmentVariable name="Backups__PgDumpExecutablePath" value="C:\Program Files\PostgreSQL\18\bin\pg_dump.exe" />
          <environmentVariable name="Backups__BackupRootDirectory" value="C:\hms-backups" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
