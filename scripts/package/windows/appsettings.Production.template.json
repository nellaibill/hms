{
  // The packaged Windows install's settings. The installer copies this into the install folder
  // as appsettings.Production.json and replaces every __NAME__ placeholder with that hospital's
  // own values. Never commit real values here. See README.md next to this file.
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:__HTTPS_PORT__",
        "Certificate": {
          "Path": "__CERTIFICATE_PFX_PATH__",
          "Password": "__CERTIFICATE_PFX_PASSWORD__"
        }
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=hms_platform;Username=hms;Password=__DB_PASSWORD__",
    "Platform": "Host=localhost;Port=5432;Database=hms_platform;Username=hms;Password=__DB_PASSWORD__",
    "PlatformAdmin": "Host=localhost;Port=5432;Database=postgres;Username=hms;Password=__DB_PASSWORD__"
  },
  "Jwt": {
    "SigningKey": "__JWT_SIGNING_KEY__"
  },
  // Every hospital is created through Register Hospital, never the dev-only legacy tenant
  // (Program.cs defaults this to true).
  "Bootstrap": {
    "SeedLegacyTenant": false
  },
  // The one Platform Admin account `HMS.Api.exe migrate` seeds on first install. Its password is
  // passed to that one migrate run only (PlatformAdminSeed__Password), never written here.
  "PlatformAdminSeed": {
    "FullName": "__PLATFORM_ADMIN_FULL_NAME__",
    "Email": "__PLATFORM_ADMIN_EMAIL__"
  },
  "Backups": {
    "PgDumpExecutablePath": "__PG_BIN_DIR__\\pg_dump.exe",
    "BackupRootDirectory": "__BACKUP_DIR__"
  },
  "Sync": {
    "Role": "None"
  }
}
