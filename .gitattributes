# Auto-detect text files and normalize line endings to LF by default
* text=auto eol=lf

# Source
*.cs        text diff=csharp
*.csproj    text
*.sln       text eol=crlf
*.ts        text
*.tsx       text
*.js        text
*.jsx       text
*.json      text
*.md        text
*.yml       text
*.yaml      text

# Binary assets — never normalize
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
